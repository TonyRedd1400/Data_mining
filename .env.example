# Copiar este archivo a .env y rellenar con valores PROPIOS.
# .env está en .gitignore: jamás commitear claves reales (repositorio público).

# --- Proveedor de búsqueda (Brave Search API) ---
BRAVE_API_KEY=REEMPLAZAR_CON_CLAVE_FICTICIA_EJEMPLO

# --- Clasificador LLM (Google Gemini API, free tier) ---
GEMINI_API_KEY=REEMPLAZAR_CON_CLAVE_FICTICIA_EJEMPLO
GEMINI_MODEL=gemini-flash-ejemplo

# --- Ajustes opcionales (los valores reales viven en config/settings.yaml) ---
DLM_PROVIDER=brave
DLM_MODE=live            # live | mock
DLM_MAX_DAILY_CALLS=100
